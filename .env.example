# ─── Backend connection ───
SIGNAL_BACKEND_URL=http://127.0.0.1:3400
CLIENT_POLL_MS=15000
CLIENT_HEARTBEAT_MS=10000

# ─── Licensing (issued from the admin panel) ───
# Create a client in the admin panel, authorize it, set its allowed IP(s),
# then copy its API key here. Required — the bot cannot start without it.
CLIENT_API_KEY=sk_live_your_key_here
# Optional: pin a stable instance id. If unset, one is generated and stored in
# ./.instance-id so restarts re-claim the same session (avoids self double-bot).
# CLIENT_INSTANCE_ID=

# ─── KuCoin Futures credentials ───
KUCOIN_BASE_URL=https://api-futures.kucoin.com
KUCOIN_API_KEY=your_key
KUCOIN_API_SECRET=your_secret
KUCOIN_API_PASSPHRASE=your_passphrase
KUCOIN_API_KEY_VERSION=2

# ─── Order behavior ───
KUCOIN_ORDER_SIZE=1
KUCOIN_CLOSE_RETRY_MAX=3
KUCOIN_ORDER_STATUS_TIMEOUT_MS=20000
KUCOIN_ORDER_STATUS_POLL_MS=1500
