# ─── Backend connection ───
# Production signal server (default if unset). For local development against your
# own backend, set this to http://127.0.0.1:3400 instead.
SIGNAL_BACKEND_URL=https://provider.hipobot.xyz
CLIENT_POLL_MS=15000
CLIENT_HEARTBEAT_MS=10000

# ─── Licensing (issued from the admin panel) ───
# Create a client in the admin panel, authorize it, set its allowed IP(s),
# then copy its API key here. Required — the bot cannot start without it.
CLIENT_API_KEY=sk_live_your_key_here
# Optional: pin a stable instance id. If unset, one is generated and stored in
# ./.instance-id so restarts re-claim the same session (avoids self double-bot).
# CLIENT_INSTANCE_ID=

# ─── KuCoin Futures credentials ───
KUCOIN_BASE_URL=https://api-futures.kucoin.com
KUCOIN_API_KEY=your_key
KUCOIN_API_SECRET=your_secret
KUCOIN_API_PASSPHRASE=your_passphrase
KUCOIN_API_KEY_VERSION=2
# Leverage applied to position-OPENING orders. KuCoin REQUIRES this or it rejects
# the order with code 100001 "Leverage parameter invalid." Match the strategy's
# configured leverage. Not sent on closing (reduceOnly) orders. Default: 20.
KUCOIN_LEVERAGE=20

# ─── Order behavior ───
# KUCOIN_ORDER_SIZE is the FALLBACK contract size used only when risk-based
# sizing has no data (no balance / missing contract spec). Normal sizing comes
# from the risk % the backend pushes (set per-bot in the admin panel).
KUCOIN_ORDER_SIZE=1
# Trading capital YOU allocate to the bot (in your wallet currency). When set (>0),
# the backend's risk % is applied to THIS amount instead of your full account
# equity, so you can run the bot on only part of your balance. Capped at your
# real equity. Leave 0/blank to size off the full account equity.
TRADING_CAPITAL=0
KUCOIN_CLOSE_RETRY_MAX=3
KUCOIN_ORDER_STATUS_TIMEOUT_MS=20000
KUCOIN_ORDER_STATUS_POLL_MS=1500
# Wallet currency for the account-overview balance (USDT-margined futures).
KUCOIN_ACCOUNT_CURRENCY=USDT
# Optional hard cap on contracts per order (0 = uncapped) — a safety rail over risk sizing.
KUCOIN_MAX_ORDER_SIZE=0
